# Copy this file to .env. Never commit real credentials.

# Required only for BacDive downloads.
BACDIVE_USERNAME=
BACDIVE_PASSWORD=

# Required only for the LPSN API transform.
LPSN_USERNAME=
LPSN_PASSWORD=

# Used by `gh` for local release commands. Keep it in the environment; never
# embed it in a Git remote or write it into the repository.
GH_TOKEN=

# Transform behavior.
GOLD_APPLY_TAXON_TRIM=true
METATRAITS_MULTIPROCESSING=true
# Empty means auto-detect from CPU and memory; each worker needs about 3 GB RAM.
METATRAITS_WORKERS=
# Dangerous opt-in: permits old YAML/HTTP caches when the MediaDive bulk input
# is missing. Keep false for production builds. Export in the shell because this
# transform path does not guarantee that .env has been loaded.
KG_MEDIADIVE_ALLOW_STALE_CACHE=false

# PREGO defaults. `habitat` matches merge.yaml; `all` must be paired with
# merge.prego-full.yaml. Confidence is a graph-size lever, not a uniform quality
# score. Read docs/PREGO_SCORE_VALIDATION.md before changing these values.
PREGO_SHAPES=habitat
PREGO_MIN_CONFIDENCE=0
PREGO_HABITAT_MIN_SCORE=1.0

# Ontology cache policy. Setting KG_SEMSQL_BUILD=off deliberately permits reuse
# of stale prebuilt databases with warnings; do not use it for release builds.
KG_SEMSQL_BUILD=on
KG_GO_VERSION_CHECK=strict
KG_NCBITAXON_VERSION_CHECK=warn
KG_CHEBI_VERSION_CHECK=warn
# JVM options passed to ROBOT ontology conversions.
ROBOT_JAVA_ARGS=-Xmx12g -XX:+UseG1GC

# KGX/BMT model inputs. Defaults are the repository-pinned downloads below.
KG_MICROBE_BIOLINK_MODEL=data/raw/biolink-model.yaml
KG_MICROBE_BIOLINK_PREDICATE_MAP=data/raw/predicate_mapping.yaml

# Test/fixture injection points. Normal builds should keep these defaults.
KG_MICROBE_METPO_JSON=data/raw/metpo.json
KG_MICROBE_METPO_TEMPLATE_DIR=data/raw
# Pytest sets this automatically in the offline unit-test job.
KG_MICROBE_TESTS_NO_NETWORK=0
# Opt in to tests that start local servers or call live services.
KG_MICROBE_RUN_INTEGRATION=0
