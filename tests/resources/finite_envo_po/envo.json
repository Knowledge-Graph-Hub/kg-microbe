          "lbl": "combustion process",
          "type": "CLASS",
          "meta": {
            "definition": {
              "val": "Combustion or burning is a high-temperature exothermic redox chemical reaction between a fuel and an oxidant that produces oxidized, often gaseous products, in a mixture termed as smoke.",
              "xrefs": [
                "https://en.wikipedia.org/wiki/Combustion"
              ]
            },
            "comments": [
              "Unlike the \"combustion\" class in the Chemical Methods Ontology, this class is not necessarily a planned process. http://purl.obolibrary.org/obo/CHMO_0001473"
            ],
