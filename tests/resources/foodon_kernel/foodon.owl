        <obo:IAO_0000115 xml:lang="en">Soft wheat (red or white) are lower protein (gluten), higher starch varieties used for cakes, pie crusts, biscuits and muffins.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=B1421"/>
        <oboInOwl:hasSynonym xml:lang="en">triticum aestivum</oboInOwl:hasSynonym>
        <rdfs:label xml:lang="en">soft wheat plant</rdfs:label>
    </owl:Class>
    


