        <oboInOwl:hasNarrowSynonym>Triticum aestivum L.</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>Triticum aestivum subsp. aestivum</oboInOwl:hasNarrowSynonym>
