        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/obi.owl"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/ons.owl"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/pato.owl"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uberon.owl"/>
        <rdfs:label>quality</rdfs:label>
    </owl:Class>
    


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0000014">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000051"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001300"/>
        <obo:IAO_0000115>A composite chromatic quality composed of hue, saturation and intensity parts.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/pato.owl"/>
        <rdfs:label>color</rdfs:label>
    </owl:Class>
    


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0000051">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001241"/>
        <obo:IAO_0000115>A quality of a single physical entity inhering in the bearer by virtue of the bearer's size or shape or structure.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/pato.owl"/>
        <rdfs:label>morphology</rdfs:label>
    </owl:Class>
    


