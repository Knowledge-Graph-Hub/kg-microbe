        <oboInOwl:hasExactSynonym xml:lang="en">string bean</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">stringless bean</oboInOwl:hasExactSynonym>
        <rdfs:comment xml:lang="en">Immature or young pods of the runner bean (Phaseolus coccineus), yardlong bean (Vigna unguiculata subsp. sesquipedalis), and hyacinth bean (Lablab purpureus) are used in a similar way.

SIREN DB annotation:
* whole, natural shape FOODON:03430150
* not heat-treated FOODON:03440003
* pod containing small, immature seed FOODON:03420169</rdfs:comment>
        <rdfs:label xml:lang="en">green bean pod</rdfs:label>
    </owl:Class>
    


