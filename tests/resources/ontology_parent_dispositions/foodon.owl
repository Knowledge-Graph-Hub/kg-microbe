            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A product of the  dry seeds of Lablab purpureus.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">hyacinth bean food product</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FOODON_00001208"/>
