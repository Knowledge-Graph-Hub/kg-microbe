    </owl:Class>
    


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03414065">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03411479"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
