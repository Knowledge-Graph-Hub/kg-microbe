        <oboInOwl:hasNarrowSynonym>Theragra chalcogramma (Pallas, 1811)</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>Theragra chalcogramma (Pallas, 1814)</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasSynonym xml:lang="en">theragra chalcogramma</oboInOwl:hasSynonym>
