    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03411005">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03411057"/>
        <obo:IAO_0000112 xml:lang="en">Examples of stem vegetables are kohlrabi, celery, fennel and rhubarb.  Examples of shoot vegetables are asparagus, hop, bamboo shoots and taugé.</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000115 xml:lang="en">A vegetable having shoot or stem which can be cooked and eaten.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-5275-8866"/>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=B1005"/>
        <oboInOwl:hasExactSynonym xml:lang="en">shoot vegetable</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">spear vegetable</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">stem or spear vegetable plant</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://foodcommodities.nl/commodities/vegetables.html"/>
    </owl:Class>
    


