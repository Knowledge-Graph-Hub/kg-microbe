        <oboInOwl:hasDbXref rdf:resource="https://bioregistry.io/reference/siren:F10419"/>
        <rdfs:label xml:lang="en">algae material</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://ungc-communications-assets.s3.amazonaws.com/docs/publications/The-Seaweed-Manifesto.pdf"/>
    </owl:Class>
    


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00001201">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00001209"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00001757"/>
        <obo:IAO_0000115 xml:lang="en">A dry bean food product refers to a bean product made from a Phaseolus species plant whose seeds are harvested at complete maturity.</obo:IAO_0000115>
        <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Phaseolus_vulgaris</obo:IAO_0000119>
        <dcterms:contributor xml:lang="en">Damion Dooley</dcterms:contributor>
        <oboInOwl:hasNarrowSynonym xml:lang="en">kidney, haricot bean (Ph. vulgaris); 
lima, butter bean (Ph. lunatus); 
adzuki bean (Ph. angularis); 
mungo bean, golden, green gram (Ph. aureus); 
black gram, urd (Ph. mungo); 
scarlet runner bean (Ph. coccineus); 
rice bean (Ph. calcaratus); 
moth bean (Ph. aconitifolius); 
tepary bean (Ph. acutifolius)</oboInOwl:hasNarrowSynonym>
        <rdfs:comment xml:lang="en">FAO notes: "Only species of Phaseolus should be included, though several countries also include certain types of beans. Commonly classified as Vigna (angularis, mungo, radiata, aconitifolia). In the past, these species were also classified as Phaseolus."</rdfs:comment>
        <rdfs:label xml:lang="en">dry bean food product</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.fao.org/WAICENT/faoinfo/economic/faodef/fdef04e.htm#4.02</rdfs:seeAlso>
    </owl:Class>
    


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00001202">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
