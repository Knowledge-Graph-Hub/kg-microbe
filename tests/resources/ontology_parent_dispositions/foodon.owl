        <oboInOwl:hasExactSynonym xml:lang="en">green bean</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="fr">haricot vert</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">snap bean</oboInOwl:hasExactSynonym>
