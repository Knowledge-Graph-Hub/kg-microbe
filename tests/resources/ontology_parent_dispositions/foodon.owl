    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03411998">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00005708"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03411374"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <obo:IAO_0000115 xml:lang="en">The Decapoda or decapods (literally "ten-footed") are an order of crustaceans within the class Malacostraca, including many familiar groups, such as crayfish, crabs, lobsters, prawns, and shrimp. Most decapods are scavengers. [https://en.wikipedia.org/wiki/Decapoda]</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:resource="http://www.langual.org/langual_thesaurus.asp?termid=B1998"/>
        <oboInOwl:hasSynonym xml:lang="en">decapoda</oboInOwl:hasSynonym>
        <rdfs:label xml:lang="en">decapod</rdfs:label>
    </owl:Class>
    


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03412163">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03411505"/>
