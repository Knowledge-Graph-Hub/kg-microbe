        <oboInOwl:hasNarrowSynonym>Salmo trutta Linnaeus, 1758</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasSynonym xml:lang="en">salmo trutta</oboInOwl:hasSynonym>
