            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A bean food product which derives from a winged bean plant (Psophocarpus tetragonolobus).</obo:IAO_0000115>
        <obo:IAO_0000119>https://en.wikipedia.org/wiki/Winged_bean</obo:IAO_0000119>
        <dcterms:contributor>https://orcid.org/0000-0002-8844-9165</dcterms:contributor>
        <rdfs:label xml:lang="en">winged bean food product</rdfs:label>
    </owl:Class>
    


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00001208">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FOODON_00001209"/>
