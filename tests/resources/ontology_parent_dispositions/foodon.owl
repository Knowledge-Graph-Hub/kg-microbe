        <rdfs:label>1-D extent</rdfs:label>
    </owl:Class>
    


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0002198">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001018"/>
