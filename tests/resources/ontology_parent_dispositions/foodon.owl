        <obo:IAO_0000115 xml:lang="en">An unripe, young fruit of various cultivars of a common bean plant (Phaseolus vulgaris).</obo:IAO_0000115>
        <obo:IAO_0000119>https://en.wikipedia.org/wiki/Green_bean</obo:IAO_0000119>
