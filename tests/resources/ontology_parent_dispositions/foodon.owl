    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00001635">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00001264"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00002153"/>
        <obo:IAO_0000115 xml:lang="en">A bean vegetable food product is a human or animal food product - such as a snap, shell or dry bean product - derived from the fruit pod, seed, or leaf of one of several genera of the flowering plant family Fabaceae.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Note, this was previously labelled "Bean (vegetable) food product". We have been listing both dry and freshly harvested moist beans here, so have broadened the name scope.</obo:IAO_0000116>
        <dcterms:contributor xml:lang="en">Damion Dooley</dcterms:contributor>
        <rdfs:label xml:lang="en">bean food product</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/FOODON_00002428"/>
        <rdfs:seeAlso rdf:resource="http://www.fao.org/es/faodef/fdef04e.htm#4.02"/>
        <rdfs:seeAlso rdf:resource="https://oconto.extension.wisc.edu/files/2011/02/The-Importance-of-Dry-Beans-in-Your-Diet.pdf"/>
    </owl:Class>
    


