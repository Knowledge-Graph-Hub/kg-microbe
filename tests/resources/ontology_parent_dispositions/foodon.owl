* seed (anatomical part) FOODON:03420155</rdfs:comment>
        <rdfs:label xml:lang="en">wheat food product</rdfs:label>
    </owl:Class>
    


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00001172">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00001262"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03460177"/>
