        <oboInOwl:hasAlternativeId>PO:0008033</oboInOwl:hasAlternativeId>
        <oboInOwl:hasBroadSynonym>cycle (broad)</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>verticil (broad)</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>FNA:12607624-3d2a-4113-bd86-0e2557f2f473</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FNA:d42df0a9-60f4-4c24-9c0b-ba815272f2fe</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GO:0048438</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GO:0048457</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GO:0048458</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GO:0048459</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PO_GIT:90</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PO_GIT:99</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>estructura colectiva del filoma (Spanish, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>葉的器官が集まった構造 (Japanese, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>floral whorl (narrow)</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>whorl (narrow)</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>phyllome whorl (related)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>PO:0025023</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/po#TraitNet"/>
        <rdfs:label>collective phyllome structure</rdfs:label>
    </owl:Class>
    


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PO_0025029">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0025004"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PO_0009006"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A plant axis (PO:0025004) that is part of a shoot system (PO:0009006).</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/po.owl"/>
        <oboInOwl:created_by>rwalls</oboInOwl:created_by>
        <oboInOwl:creation_date>2010-07-01T03:46:35Z</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>caullome (exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>eje del epiblasto (epiblastema) (Spanish, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>シュート軸 (Japanese, exact)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>plant_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>shoot (related)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>PO:0025029</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/po#Angiosperm"/>
        <oboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/po#Arabidopsis"/>
