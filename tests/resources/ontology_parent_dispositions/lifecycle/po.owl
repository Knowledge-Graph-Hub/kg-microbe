        <owl:imports rdf:resource="http://purl.obolibrary.org/obo/po/imports/ro_import.owl"/>
        <terms:description>An ontology that describes plant anatomy, morphology, and growth and development in plants.</terms:description>
        <terms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
        <terms:title>Plant Ontology</terms:title>
        <oboInOwl:default-namespace>plant_ontology</oboInOwl:default-namespace>
